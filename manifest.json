{
  "manifest_version": 3,
  "name": "LG Mercari Duplicate Checker",
  "version": "0.1.0",
  "key": "",
  "description": "メルカリ検索結果の商品をGoogleスプレッドシートと照合し、重複商品を表示するChrome拡張機能。",

  "permissions": ["identity", "storage"],

  "oauth2": {
    "client_id": "278221325249-h3fc0ch6d3lkgkgcqvbdeb4glqiksl2b.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets.readonly"]
  },

  "content_scripts": [
    {
      "matches": ["https://jp.mercari.com/search*"],
      "js": ["src/content.js"]
    }
  ],
  "options_page": "src/options/options.html"
}
